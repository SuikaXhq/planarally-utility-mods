{
    "name": "@planarally-mods/advanced-char-sheet",
    "type": "module",
    "files": [
        "dist"
    ],
    "module": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        }
    },
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "vite build --watch",
        "build:pre": "pnpm run type-check && vite build",
        "pack": "node scripts/pack.mjs",
        "deploy": "node scripts/deploy.mjs",
        "build": "pnpm run build:pre && pnpm run pack",
        "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false"
    },
    "dependencies": {
        "@planarally-mods/ui": "workspace:*",
        "vue": "^3.3.4"
    },
    "devDependencies": {
        "@planarally/mod-api": "workspace:*",
        "@types/node": "^22.0.0",
        "@vitejs/plugin-vue": "^4.3.4",
        "@vue/tsconfig": "^0.4.0",
        "archiver": "^6.0.1",
        "sass": "^1.99.0",
        "typescript": "~5.2.0",
        "vite": "^4.4.9",
        "vue-tsc": "^1.8.11"
    }
}
